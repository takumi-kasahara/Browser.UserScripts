{
  "type": "module",
  "scripts": {
    "build": "npm run lint && npm run build:gm && npm run build:page && npm run build:zip",
    "build:gm": "node --experimental-strip-types .tools/build.gm.ts",
    "build:page": "node --experimental-strip-types .tools/build.page.ts",
    "build:zip": "node --experimental-strip-types .tools/build.zip.ts",
    "lint": "prettier --write . && markdownlint-cli2 --fix . && eslint --fix .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/web": "^0.0.359",
    "@vitest/coverage-v8": "^4.1.12",
    "adm-zip": "^0.6.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "markdownlint-cli2": "^0.24.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.12"
  },
  "private": true
}
