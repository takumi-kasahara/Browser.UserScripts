{
  "type": "module",
  "scripts": {
    "build": "npm run build:gm && npm run build:zip",
    "build:gm": "node --experimental-strip-types .tools/build.gm.ts",
    "build:zip": "node --experimental-strip-types .tools/build.zip.ts",
    "lint": "prettier --write . && markdownlint-cli2 --fix . && eslint --fix .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.1.2",
    "@types/web": "^0.0.354",
    "@vitest/coverage-v8": "^4.1.10",
    "adm-zip": "^0.6.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "jsdom": "^30.0.1",
    "markdownlint-cli2": "^0.23.2",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
